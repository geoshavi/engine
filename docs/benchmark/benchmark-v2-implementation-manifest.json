  "amendments": [
    {
      "id": "A-1",
      "case": "quality-01-broken",
      "old_action": "REPAIR_FIXTURE",
      "new_action": "CLARIFY_TASK + REPAIR_FIXTURE",
      "kept": {
        "expected_verdict": "UNVERIFIED",
        "expected_defect_category": "CODE-QUALITY"
      },
      "necessary_because": "Under frozen P1/P3 a pure CODE-QUALITY defect blocks only via P1-a (needs a stated requirement; none adjudicated) or P1-b (routes to CORRECTNESS via P1-c, needing an unadjudicated category change). REPAIR_FIXTURE alone was unsatisfiable.",
      "implemented": "Task adds 'Express that ordering rule in exactly one place: it must not be restated anywhere else in the module.' Broken fixture now writes the sort key twice; clean states it once. Output identical across probes."
    },
    {
      "id": "A-2",
      "case": "quality-03-broken",
      "old_action": "REPAIR_FIXTURE",
      "new_action": "CLARIFY_TASK + REPAIR_FIXTURE",
      "necessary_because": "The first implementation changed only the task, leaving a naming-only mismatch as the supposed blocking defect and the fixture unrepaired - a material action change rejected by the conformance review.",
      "implemented": "Task requires the single name get_or_create_user AND that the default record be built in exactly one place. Broken fixture now duplicates record construction across create_user and get_user. Behaviour unchanged."
    },
    {
      "id": "A-3",
      "case": "security-04-clean",
      "old_action": "REPAIR_FIXTURE",
      "new_action": "CLARIFY_TASK + REPAIR_FIXTURE",
      "kept": {
        "expected_verdict": "OK"
      },
      "necessary_because": "The task names SSRF, so P2-T1 fires and DNS rebinding is blocking. It cannot be closed inside a bool contract, and a contract change is a task change that REPAIR_FIXTURE alone did not authorise.",
      "implemented": "Contract becomes resolve_safe_fetch_target(host) -> str | None, returning the checked address the caller must use without re-resolving. SSRF objective preserved verbatim; not narrowed to exclude rebinding.",
      "withdrawn_claim": "The first implementation reclassified the residual rebinding exposure as advisory. That applied P2's default while ignoring P2-T1 and was a re-adjudication made without authority. Withdrawn."
    }
  ],
