ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ENGINE_MAX_RETRIES=3
ENGINE_DB_PATH=.engine/state.db

# Runtime controls (execution_plan.py defaults, enforced by runtime/gateway.py
# + runtime/budget.py before every LLM call)
ENGINE_MAX_TOKENS=100000
ENGINE_TIMEOUT_SECONDS=600
ENGINE_MAX_AGENTS=10
ENGINE_PLANNED_BUDGET=1.00

# Lower ceiling for api.py's /review endpoint specifically (single-shot
# verification, no agent generation, no retries -- shouldn't share a full
# generation run's budget)
ENGINE_REVIEW_MAX_TOKENS=10000
ENGINE_REVIEW_PLANNED_BUDGET=0.10

# n8n (docker compose) - generate a key with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
